# Backend API keys (used by packages/backend)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
BRAVE_API_KEY=
GOOGLE_SEARCH_API=
GOOGLE_SEARCH_ENGINE=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
GITHUB_TOKEN=
GOOGLE_VISION_API_KEY=

# Backend server config
PORT=3000
NODE_ENV=development

# Frontend (packages/frontend .env)
# VITE_BACKEND_URL=http://localhost:3000

# Shared Postgres (AI Garage exercise) — runs analysis migrations & seeds.
# Override SCHEMA_NAME to your own personal schema name.
SHARED_DATABASE_URL=
SCHEMA_NAME=lotanna_okwuchukwu

# PII guard mode — pre-flight scan applied to every agent route before LLM
# egress. Values:
#   block (default) — return HTTP 400 / SSE error and refuse to call the LLM
#                     when a high-confidence PII match or any secret is found.
#                     Required for Protected B handling.
#   warn            — let the request through but emit a structured audit
#                     line to stderr. Use during development to discover
#                     where prompts pick up sensitive content.
#   off             — guard disabled. Dev/debug only.
PII_GUARD_MODE=block
